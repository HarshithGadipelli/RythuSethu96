      "regex": "^/agent/cold\\-storage(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/agent/cold\\-storage(?:/)?$"
    },
    {
      "page": "/agent/soil-test",
      "regex": "^/agent/soil\\-test(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/agent/soil\\-test(?:/)?$"
    },
    {
      "page": "/curated-boxes",
      "regex": "^/curated\\-boxes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/curated\\-boxes(?:/)?$"
    },
    {
      "page": "/farm-tours",
      "regex": "^/farm\\-tours(?:/)?$",

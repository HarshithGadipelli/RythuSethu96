    },
    {
      "page": "/farmer",
      "regex": "^/farmer(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/farmer(?:/)?$"
    },
    {
      "page": "/farmer/add-crop",
      "regex": "^/farmer/add\\-crop(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/farmer/add\\-crop(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/marketplace",
      "regex": "^/marketplace(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/marketplace(?:/)?$"
    },
    {
      "page": "/my-orders",
      "regex": "^/my\\-orders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/my\\-orders(?:/)?$"
    },
    {
      "page": "/offline-tours",
      "regex": "^/offline\\-tours(?:/)?$",
